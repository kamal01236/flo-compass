{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-avengers.local/schema/venue.schema.json",
  "title": "Flo 2026 Venue",
  "description": "A room within the Nagarro Gurgaon Office event campus.",
  "type": "object",
  "required": ["id", "name", "building", "floor", "zone", "wing", "capacity"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ven-[A-Z0-9]{3,5}$|^ven-[0-9]{1,2}[NS][1-6]$"
    },
    "name": { "type": "string", "minLength": 2 },
    "building": {
      "type": "string",
      "const": "Nagarro Gurgaon Office"
    },
    "floor": {
      "type": "string",
      "enum": ["G", "6", "7", "8", "9", "10", "11", "12", "13"]
    },
    "zone": {
      "type": "string",
      "enum": ["Reception", "Training", "Cafeteria", "Sitting Area"]
    },
    "wing": {
      "type": "string",
      "enum": ["N", "S", "central"]
    },
    "capacity": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500
    },
    "description": { "type": "string" },
    "mapZone": { "type": "string", "minLength": 2 },
    "landmarks": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    },
    "nearestElevator": {
      "type": "string",
      "enum": ["N", "S", "central"]
    },
    "stepFree": { "type": "boolean" }
  }
}
