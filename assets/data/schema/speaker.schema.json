{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-avengers.local/schema/speaker.schema.json",
  "title": "Flo 2026 Speaker",
  "description": "Fictional speaker persona for the Flo 2026 dataset at Nagarro Gurgaon Office.",
  "type": "object",
  "required": ["id", "name", "title", "bio", "expertiseTags"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^spk-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "bio": {
      "type": "string",
      "minLength": 30,
      "description": "Two to three sentences describing the fictional persona."
    },
    "expertiseTags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "photoAsset": {
      "type": "string",
      "pattern": "^assets/images/speakers/.+\\.(png|webp|jpg)$"
    }
  }
}
