{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-avengers.local/schema/track.schema.json",
  "title": "Flo 2026 Track",
  "description": "A content track spanning multiple sessions.",
  "type": "object",
  "required": ["id", "name", "description", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^trk-[0-9]{2}$"
    },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 5 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
